generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  user_id                   String             @id @default(uuid()) @db.Uuid
  full_name                 String?            @db.VarChar(255)
  email                     String?            @unique @db.VarChar(255)
  password_hash             String?
  avatar_url                String?
  role                      String             @default("student") @db.VarChar(50)
  created_at                DateTime?          @default(now()) @db.Timestamp(6)
  updated_at                DateTime?          @default(now()) @db.Timestamp(6)
  is_active                 Boolean            @default(false)
  verify_token              String?
  verify_token_expires      DateTime?          @db.Timestamp(6)
  school                    String?            @db.VarChar(255)
  major                     String?            @db.VarChar(255)
  current_year              Int?
  orientation               String?            @db.VarChar(255)
  objective                 String?            @db.VarChar(255)
  target_salary             Int?
  prefer_remote             Boolean?
  current_step              Int                @default(1)
  onboarding_completed      Boolean            @default(false)
  notifications             Notification[]
  saved_jobs                SavedJob[]
  saved_courses             SavedCourse[]
  auth_providers            UserAuthProvider[]
  cvs                       UserCv[]
  
  default_cv_id             String?            @unique @db.Uuid
  default_cv                UserCv?            @relation("UserDefaultCv", fields: [default_cv_id], references: [cv_id], onDelete: SetNull)

  default_match_id          String?            @unique @db.Uuid
  default_match             CvJobMatch?        @relation("UserDefaultMatch", fields: [default_match_id], references: [match_id], onDelete: SetNull)
  allow_default_cv_matching Boolean            @default(false)

  @@map("users")
}

model UserAuthProvider {
  auth_provider_id    String    @id @default(uuid()) @db.Uuid
  user_id             String    @db.Uuid
  provider            String    @db.VarChar(50)
  provider_user_id    String    @db.VarChar(255)
  provider_email      String?   @db.VarChar(255)
  provider_name       String?   @db.VarChar(255)
  provider_avatar_url String?
  created_at          DateTime? @default(now()) @db.Timestamp(6)
  last_login_at       DateTime? @db.Timestamp(6)
  user                User      @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@unique([provider, provider_user_id])
  @@index([user_id], map: "idx_user_auth_providers_user_id")
  @@map("user_auth_providers")
}

model UserCv {
  cv_id          String        @id @default(uuid()) @db.Uuid
  user_id        String        @db.Uuid
  file_name      String?       @db.VarChar(255)
  file_url       String?
  extracted_text String?
  uploaded_at    DateTime?     @default(now()) @db.Timestamp(6)
  updated_at     DateTime?     @default(now()) @db.Timestamp(6)
  matches        CvJobMatch[]
  cv_skills      UserCvSkill[]
  user           User          @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  default_for_user User?       @relation("UserDefaultCv")
  @@index([user_id], map: "idx_user_cvs_user_id")
  @@map("user_cvs")
}

model UserCvSkill {
  cv_id      String    @db.Uuid
  skill_id   Int
  created_at DateTime? @default(now()) @db.Timestamp(6)
  raw_skill  String?   @db.VarChar(255) // BỔ SUNG TỪ SQL
  cv         UserCv    @relation(fields: [cv_id], references: [cv_id], onDelete: Cascade)
  skill      Skill     @relation(fields: [skill_id], references: [skill_id], onDelete: Cascade)

  @@id([cv_id, skill_id])
  @@index([skill_id], map: "idx_user_cv_skills_skill_id")
  @@map("user_cv_skills")
}

model Company {
  company_id         BigInt            @id
  name               String            @db.VarChar(255)
  description        String?
  company_size_min   Int?
  company_size_max   Int?
  country            String?           @db.VarChar(100)
  city               String?           @db.VarChar(100)
  address            String?
  url                String?           @db.VarChar(500)
  industry           String?           @db.VarChar(255)
  updated_at         DateTime?         @default(now()) @db.Timestamp(6)
  company_industries CompanyIndustry[]
  jobs               Job[]

  @@map("companies")
}

model Industry {
  industry_id        Int               @id @default(autoincrement())
  industry_name      String            @unique @db.VarChar(255)
  company_industries CompanyIndustry[]

  @@map("industries")
}

model CompanyIndustry {
  company_id  BigInt
  industry_id Int
  company     Company  @relation(fields: [company_id], references: [company_id], onDelete: Cascade)
  industry    Industry @relation(fields: [industry_id], references: [industry_id], onDelete: Cascade)

  @@id([company_id, industry_id])
  @@map("company_industries")
}

model Job {
  job_id                     BigInt       @id @default(autoincrement())
  company_id                 BigInt?
  title                      String       @db.VarChar(500)
  skills_desc                String?
  description                String?
  formatted_experience_level String?      @db.VarChar(100)
  work_type                  String?      @db.VarChar(100)
  location                   String?      @db.VarChar(255)
  is_remote                  Boolean?     @default(false)
  listed_time                DateTime?    @db.Timestamptz(6)
  expiry_time                DateTime?    @db.Timestamptz(6)
  job_posting_url            String?
  scraped_at                 DateTime?    @default(now()) @db.Timestamp(6)
  applies                    Int?         @default(0)
  views                      Int?         @default(0)
  fingerprint                String?      @unique @db.VarChar(32)
  job_category               String?      @db.VarChar(100)
  search_group               String?      @db.VarChar(100)
  source_name                String?      @db.VarChar(50)
  source_id                  String?      @db.VarChar(255)
  updated_at                 DateTime?    @default(now()) @db.Timestamp(6)
  cv_matches                 CvJobMatch[]
  job_benefits               JobBenefit[]
  job_skills                 JobSkill[]
  company                    Company?     @relation(fields: [company_id], references: [company_id], onDelete: SetNull)
  salaries                   Salary[]
  saved_by                   SavedJob[]

  @@index([company_id], map: "idx_jobs_company_id")
  @@index([formatted_experience_level], map: "idx_jobs_experience")
  @@index([expiry_time], map: "idx_jobs_expiry_time")
  @@index([job_category], map: "idx_jobs_job_category")
  @@index([listed_time], map: "idx_jobs_listed_time")
  @@index([search_group], map: "idx_jobs_search_group")
  @@index([source_name], map: "idx_jobs_source_name")
  @@index([title], map: "idx_jobs_title")
  @@index([skills_desc], map: "idx_jobs_skills_search")
  @@map("jobs")
}

model Salary {
  salary_id  Int      @id @default(autoincrement())
  job_id     BigInt?
  min_salary Decimal? @db.Decimal(18, 2)
  max_salary Decimal? @db.Decimal(18, 2)
  med_salary Decimal? @db.Decimal(18, 2)
  currency   String?  @default("VND") @db.VarChar(10)
  pay_period String?  @db.VarChar(20)
  job        Job?     @relation(fields: [job_id], references: [job_id], onDelete: Cascade)

  @@index([job_id], map: "idx_salaries_job_id")
  @@map("salaries")
}

model Skill {
  skill_id                Int                   @id @default(autoincrement())
  skill_name              String                @unique @db.VarChar(255)
  category                String?               @db.VarChar(255)
  created_at              DateTime?             @default(now()) @db.Timestamp(6)
  type                    String?               @db.VarChar(100)
  updated_at              DateTime?             @default(now()) @db.Timestamp(6)
  job_group_skill_weights JobGroupSkillWeight[]
  job_skills              JobSkill[]
  user_cv_skills          UserCvSkill[]
  unmatched_skills        UnmatchedSkill[]      

  @@map("skills")
}

model JobSkill {
  job_id           BigInt
  skill_id         Int
  is_inferred      Boolean? @default(false)
  reason           String?  @db.VarChar(50)
  model_name       String?  @db.VarChar(100)
  similarity_score Decimal? @db.Decimal(4, 3)
  lib_version      String?  @db.VarChar(20)
  raw_skill_name   String?  @db.VarChar(255)
  job              Job      @relation(fields: [job_id], references: [job_id], onDelete: Cascade)
  skill            Skill    @relation(fields: [skill_id], references: [skill_id], onDelete: Cascade)

  @@id([job_id, skill_id])
  @@map("job_skills")
}

model Benefit {
  benefit_id   Int          @id @default(autoincrement())
  benefit_name String       @unique @db.VarChar(255)
  category     String?      @db.VarChar(100)
  created_at   DateTime?    @default(now()) @db.Timestamp(6)
  job_benefits JobBenefit[]

  @@map("benefits")
}

model JobBenefit {
  job_id      BigInt
  benefit_id  Int
  is_inferred Boolean? @default(false)
  benefit     Benefit  @relation(fields: [benefit_id], references: [benefit_id], onDelete: Cascade)
  job         Job      @relation(fields: [job_id], references: [job_id], onDelete: Cascade)

  @@id([job_id, benefit_id])
  @@map("job_benefits")
}

model JobGroupSkillWeight {
  search_group String  @db.VarChar(100)
  skill_id     Int
  weight_wi    Decimal @db.Decimal(8, 4)
  skill        Skill   @relation(fields: [skill_id], references: [skill_id], onDelete: Cascade)

  @@id([search_group, skill_id])
  @@map("job_group_skill_weights")
}

model CvJobMatch {
  match_id         String    @id @default(uuid()) @db.Uuid
  cv_id            String    @db.Uuid
  match_type       String    @db.VarChar(50)
  search_group     String?   @db.VarChar(100)
  job_id           BigInt?
  match_score      Decimal?  @db.Decimal(5, 2)
  radar_data       Json?
  gap_report       Json?
  model_version    String?   @db.VarChar(100)
  created_at       DateTime? @default(now()) @db.Timestamp(6)
  updated_at       DateTime? @default(now()) @db.Timestamp(6)
  cv               UserCv    @relation(fields: [cv_id], references: [cv_id], onDelete: Cascade)
  job              Job?      @relation(fields: [job_id], references: [job_id], onDelete: SetNull)
  default_for_user User?     @relation("UserDefaultMatch")

  @@index([created_at], map: "idx_cv_job_matches_created_at")
  @@index([cv_id], map: "idx_cv_job_matches_cv_id")
  @@index([job_id], map: "idx_cv_job_matches_job_id")
  @@index([match_type], map: "idx_cv_job_matches_match_type")
  @@index([search_group], map: "idx_cv_job_matches_search_group")
  @@map("cv_job_matches")
}

model SearchGroupKeyword {
  id        Int    @id @default(autoincrement())
  group_key String @db.VarChar(255)
  keyword   String @unique @db.VarChar(255)

  @@index([keyword], map: "idx_search_group_keywords_keyword")
  @@map("search_group_keywords")
}

model UnmatchedSkill {
  unmatched_id             Int                    @id @default(autoincrement())
  raw_skill_name           String                 @unique @db.VarChar(255)
  occurrence_count         Int?                   @default(1)
  max_similarity_score     Decimal?               @db.Decimal(4, 3)
  analysis_type            String?                @db.VarChar(50)
  first_seen               DateTime?              @default(now()) @db.Timestamp(6)
  last_seen                DateTime?              @default(now()) @db.Timestamp(6)
  top_candidate_skill_id   Int?
  top_candidate_skill_name String?                @db.VarChar(255)
  
  candidate_skill          Skill?                 @relation(fields: [top_candidate_skill_id], references: [skill_id], onDelete: SetNull)
  sources                  UnmatchedSkillSource[]

  @@index([analysis_type], map: "idx_unmatched_skills_analysis_type")
  @@index([raw_skill_name], map: "idx_unmatched_skills_raw_name")
  @@map("unmatched_skills")
}

model UnmatchedSkillSource {
  source_id            BigInt
  unmatched_id         Int
  source_type          String         @db.VarChar(50)
  occurrence_count     Int?           @default(1)
  max_similarity_score Decimal?       @db.Decimal(4, 3)
  first_seen           DateTime?      @default(now()) @db.Timestamp(6)
  last_seen            DateTime?      @default(now()) @db.Timestamp(6)
  
  unmatched_skill      UnmatchedSkill @relation(fields: [unmatched_id], references: [unmatched_id], onDelete: Cascade)

  @@id([source_id, unmatched_id, source_type])
  @@map("unmatched_skill_sources")
}

model NotificationTemplate {
  template_id         String   @id @default(uuid()) @db.Uuid
  template_code       String   @unique @db.VarChar(100)
  channel             String   @default("in_app") @db.VarChar(30)
  type                String   @default("system") @db.VarChar(50)
  priority            String   @default("normal") @db.VarChar(20)
  title_template      String   @db.VarChar(255)
  message_template    String
  action_url_template String?
  metadata_schema     Json     @default("{}")
  is_active           Boolean  @default(true)
  created_at          DateTime @default(now()) @db.Timestamp(6)
  updated_at          DateTime @default(now()) @db.Timestamp(6)

  @@index([is_active], map: "idx_notification_templates_active")
  @@map("notification_templates")
}

model Notification {
  notification_id String    @id @default(uuid()) @db.Uuid
  user_id         String    @db.Uuid
  type            String    @default("system") @db.VarChar(50)
  title           String    @db.VarChar(255)
  message         String
  action_url      String?
  entity_type     String?   @db.VarChar(50)
  entity_id       String?
  status          String    @default("unread") @db.VarChar(20)
  priority        String    @default("normal") @db.VarChar(20)
  is_read         Boolean   @default(false)
  read_at         DateTime? @db.Timestamp(6)
  metadata        Json      @default("{}")
  created_at      DateTime  @default(now()) @db.Timestamp(6)
  updated_at      DateTime  @default(now()) @db.Timestamp(6)
  user            User      @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([entity_type, entity_id], map: "idx_notifications_entity")
  @@index([user_id, created_at(sort: Desc)], map: "idx_notifications_user_created_at")
  @@index([user_id, is_read], map: "idx_notifications_user_is_read")
  @@index([user_id, status], map: "idx_notifications_user_status")
  @@map("notifications")
}

model SavedJob {
  saved_job_id String   @id @default(uuid()) @db.Uuid
  user_id      String   @db.Uuid
  job_id       BigInt
  created_at   DateTime @default(now()) @db.Timestamp(6)
  job          Job      @relation(fields: [job_id], references: [job_id], onDelete: Cascade)
  user         User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@unique([user_id, job_id])
  @@index([user_id], map: "idx_saved_jobs_user_id")
  @@map("saved_jobs")
}

// ==========================================
// MODELS CHO KHÓA HỌC & LỘ TRÌNH (LEARNING ROADMAP)
// ==========================================

model Course {
  course_id       String     @id @default(uuid()) @db.Uuid
  course_title    String     @db.VarChar(500)
  provider_name   String     @db.VarChar(100)
  source_url      String?    @db.Text
  thumbnail_icon  String?    @db.VarChar(50)
  duration_hours  Int
  rating          Decimal    @default(4.5) @db.Decimal(3, 2)
  total_learners  String     @db.VarChar(50) // Ví dụ: "33.8K"
  price           Decimal    @default(0.00) @db.Decimal(10, 2)
  currency        String     @default("USD") @db.VarChar(10)
  skills_tags     String[]   // Mảng chuỗi các kĩ năng liên quan
  is_recommended  Boolean    @default(false) // Dùng cho mục "Recommended for You"

  // Quan hệ
  paths_included  PathCourse[]
  saved_by_users  SavedCourse[]

  @@map("courses")
}

model LearningPath {
  path_id                   String       @id @default(uuid()) @db.Uuid
  path_title                String       @db.VarChar(255)
  path_description          String       @db.Text
  path_level                String       @default("Intermediate") @db.VarChar(50) // Beginner | Intermediate | Advanced
  path_icon                 String       @default("rocket") @db.VarChar(50)
  estimated_duration_months String       @default("2 months") @db.VarChar(50)
  skill_key                 String       @db.VarChar(255) // Đồng bộ để UI filter theo skill từ DB

  // Quan hệ
  courses_in_path           PathCourse[]

  @@map("learning_paths")
}

// Bảng trung gian định nghĩa danh sách khóa học nằm trong Lộ trình
model PathCourse {
  path_id     String       @db.Uuid
  course_id   String       @db.Uuid
  sort_order  Int          @default(0) // Thứ tự hiển thị trong lộ trình

  path        LearningPath @relation(fields: [path_id], references: [path_id], onDelete: Cascade)
  course      Course       @relation(fields: [course_id], references: [course_id], onDelete: Cascade)

  @@id([path_id, course_id])
  @@map("path_courses")
}

// Bảng lưu các khóa học mà User đã bấm Lưu / Bookmark hoặc Đánh dấu đã học xong
model SavedCourse {
  user_id     String   @db.Uuid
  course_id   String   @db.Uuid
  status      String   @default("saved") // "saved" (Đã lưu) hoặc "completed" (User tự tích chọn đã hoàn thành)
  created_at  DateTime @default(now()) @db.Timestamp(6)

  user        User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  course      Course   @relation(fields: [course_id], references: [course_id], onDelete: Cascade)

  @@id([user_id, course_id])
  @@map("saved_courses")
}